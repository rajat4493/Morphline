<Activity x:Class="Main"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:api="clr-namespace:UiPath.WebAPI.Activities;assembly=UiPath.WebAPI.Activities">
  <!-- SYNTHETIC TEST FIXTURE: not a real UiPath export. -->
  <Sequence DisplayName="Main Sequence">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Double" Name="SourceTotal" />
      <Variable x:TypeArguments="x:Double" Name="TargetTotal" />
    </Sequence.Variables>

    <TryCatch DisplayName="Ledger Fetch Try Catch">
      <TryCatch.Try>
        <Sequence DisplayName="Fetch Ledger Totals">
          <HTTPRequest DisplayName="Get Source Ledger Total" Method="GET" EndPoint="https://ledger.internal.example/api/source/total" />
          <HTTPRequest DisplayName="Get Target Ledger Total" Method="GET" EndPoint="https://ledger.internal.example/api/target/total" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <RetryScope DisplayName="Retry Ledger Fetch">
          <LogMessage DisplayName="Log Fetch Retry" />
        </RetryScope>
      </TryCatch.Catches>
    </TryCatch>

    <If DisplayName="Totals Equal">
      <If.Then>
        <LogMessage DisplayName="Log Totals Match" />
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Record Mismatch">
          <HTTPRequest DisplayName="Post Mismatch Record" Method="POST" EndPoint="https://ledger.internal.example/api/mismatches" />
          <LogMessage DisplayName="Log Totals Mismatch" />
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
