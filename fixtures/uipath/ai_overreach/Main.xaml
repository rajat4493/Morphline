<Activity x:Class="Main"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:api="clr-namespace:UiPath.WebAPI.Activities;assembly=UiPath.WebAPI.Activities"
  xmlns:ai="clr-namespace:UiPath.MLServices.Activities;assembly=UiPath.MLServices.Activities">
  <!-- SYNTHETIC TEST FIXTURE: not a real UiPath export. -->
  <Sequence DisplayName="Main Sequence">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ReportData" />
      <Variable x:TypeArguments="x:String" Name="HeaderText" />
    </Sequence.Variables>

    <HTTPRequest DisplayName="Get Report Data" Method="GET" EndPoint="https://reports.internal.example/api/data" />
    <GenerateText DisplayName="Format Header Date String" />
    <LogMessage DisplayName="Log Report Generated" />
  </Sequence>
</Activity>
